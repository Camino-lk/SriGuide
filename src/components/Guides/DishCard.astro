---
/*
 * Props:
 *   name   (required) - Dish name (per locale)
 *   image  (required) - Path to image served from /public, e.g. "/img/food/kottu-roti.jpg"
 *   alt    (required) - Alt text for the image (per locale)
 *   spice  (optional) - Spice level 0-3. Rendered as chili icons, omit/hide if 0.
 *   veg    (optional) - Marks the dish as vegetarian-friendly. Rendered as an emoji.
 *   tag    (optional) - Short highlight label, e.g. "Must try" (per locale)
 *
 * Usage (inside DishGrid):
 *   <DishCard name="Kottu Roti" image="/img/food/kottu-roti.jpg" alt="..." spice={2} tag="Must try">
 *     Chopped roti bread stir-fried with egg, veg and your choice of meat...
 *   </DishCard>
 */

const { name, image, alt, spice = 0, veg = false, tag } = Astro.props;
const spiceLevel = Math.max(0, Math.min(3, spice));
---

<div class="dish-card">
  <div class="dish-image-wrapper">
    <img src={image} alt={alt} loading="lazy" class="dish-image" />
    {tag && <span class="dish-tag">{tag}</span>}
    {
      veg && (
        <span
          class="dish-veg"
          role="img"
          aria-label="vegetarian-friendly"
          title="Vegetarian-friendly"
        >
          🌿
        </span>
      )
    }
  </div>

  <div class="dish-body">
    <h3 class="dish-name">{name}</h3>

    {
      spiceLevel > 0 && (
        <p
          class="dish-spice"
          role="img"
          aria-label={`spice level ${spiceLevel} of 3`}
          title={`Spice level: ${spiceLevel} of 3`}
        >
          {Array.from({ length: 3 }).map((_, i) => (
            <span class={i < spiceLevel ? "chili on" : "chili"}>🌶️</span>
          ))}
        </p>
      )
    }

    <div class="dish-desc">
      <slot />
    </div>
  </div>
</div>

<style>
  .dish-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 11px;
    overflow: hidden;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    transition:
      transform 0.2s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .dish-card:hover {
    transform: translateY(-6px);
    border-color: var(--sl-color-accent);
    box-shadow: 0 5px 20px
      color-mix(in srgb, var(--sl-color-accent) 20%, transparent);
  }

  .dish-image-wrapper {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--sl-color-bg-nav);
    overflow: hidden;
  }

  .dish-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dish-tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    border-radius: 999px;
    background: var(--sl-color-text-accent);
    border: 1px solid var(--sl-color-accent);
    color: var(--sl-color-text-invert);
  }

  .dish-veg {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    border-radius: 50%;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-accent);
    cursor: default;
  }

  .dish-body {
    padding: 1rem 1.1rem 1.2rem;
  }

  .dish-name {
    margin: 0 0 0.3rem 0;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .dish-spice {
    margin: 0 0 0.5rem 0;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    cursor: default;
  }

  .dish-spice .chili {
    opacity: 0.25;
    filter: grayscale(1);
  }

  .dish-spice .chili.on {
    opacity: 1;
    filter: none;
  }

  .dish-desc {
    font-size: 0.92rem;
    color: var(--sl-color-text-secondary);
    line-height: 1.5;
  }

  .dish-desc :global(p) {
    margin: 0;
  }
</style>
