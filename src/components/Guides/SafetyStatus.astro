---
const safety = {
  level: 85, // <----- 0-100 value indicating safety level
  label: "Safe to visit", // <----- Short label for safety status
  updated: "August 17, 2026", // <----- Update date for the safety status
  message:
    "No active wars or significant protests. Elevated dengue risk in some areas. Central and Southern regions are experiencing occasional heavy rainfall due to the monsoon.",
};

const globalTravel = {
  status: "Stable", // <----- Stable > Caution > Warning > Disrupted
  description:
    "Regional conflicts in Middle East may cause occasional flight delays or rerouting. Local destinations functions normally. Expect minor price adjustments on fuel and transportation.",
};
---

<section class="safety-grid">
  <!-- Safety meter card -->
  <div class="stat-card">
    <h3 class="cursive-text">Travel Safety Status</h3>
    <span class="sr-only">
      Current safety status: {safety.label}. Safety score {safety.level} out of 100.
      Last updated {safety.updated}.
    </span>
    <div
      class="meter"
      role="progressbar"
      aria-label="Sri Lanka travel safety level"
      aria-valuenow={safety.level}
      aria-valuemin="0"
      aria-valuemax="100"
    >
      <!-- segments -->
      <div class="segment red"></div>
      <div class="segment orange"></div>
      <div class="segment yellow"></div>
      <div class="segment green"></div>

      <!-- indicator -->
      <div
        class="meter-indicator"
        aria-hidden="true"
        style={`left:${safety.level}%`}
        title={`${safety.label} (${safety.level}%) - Updated ${safety.updated}`}
      >
        <div class="meter-fill"></div>
      </div>
    </div>

    <p class="status">
      {safety.label} ({safety.level}%)
    </p>

    <p class="message">{safety.message}</p>

    <span class="updated">Updated {safety.updated}</span>

    <!-- follow news section -->
    <div class="news-src not-content">
      <p class="src-title">Follow News:</p>
      <a
        class="src-pill"
        href="https://www.dailymirror.lk/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img class="pill-icon" src="/img/src-icons/daily-mirror.avif" alt="" />
        <p class="pill-text">Daily Mirror</p>
      </a>
      <a
        class="src-pill"
        href="https://english.newsfirst.lk/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img class="pill-icon" src="/img/src-icons/news-first.avif" alt="" />
        <p class="pill-text">News First</p>
      </a>
      <a
        class="src-pill"
        href="https://www.hirunews.lk/en/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img class="pill-icon" src="/img/src-icons/hiru-news.avif" alt="" />
        <p class="pill-text">Hiru News</p>
      </a>
    </div>
  </div>

  <!-- Travel conditions -->
  <div class="stat-card stat">
    <h3 class="cursive-text">Travel Conditions</h3>
    <span class="sr-only">
      Current travel conditions: {globalTravel.status}. {
        globalTravel.description
      }
    </span>
    <div
      class={`big-stat ${globalTravel.status.toLowerCase()}`}
      role="status"
      aria-label={`Travel conditions: ${globalTravel.status}`}
    >
      {globalTravel.status}
    </div>

    <p class="stat-text">
      {globalTravel.description}
    </p>
  </div>
</section>

<style>
  .safety-grid {
    display: grid;
    gap: 1.2rem;
    margin: 1rem 0;
    grid-template-columns: repeat(2, 1fr);
    align-items: stretch;
  }

  @media (max-width: 800px) {
    .safety-grid {
      grid-template-columns: 1fr;
    }
  }

  /* cards */

  .stat-card {
    padding: 1.4rem;
    margin-top: 0px;
    border-radius: 14px;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    display: flex;
    flex-direction: column;
  }

  /* meter */

  .meter {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 12px;
    border-radius: 999px;
    margin: 1rem 0 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
  }

  /* segments */
  .segment {
    margin-top: 0px;
  }

  .segment.red {
    background: #ff4d4d;
  }

  .segment.orange {
    background: #ff9900;
  }

  .segment.yellow {
    background: #ffcc00;
  }

  .segment.green {
    background: #4caf50;
  }

  /* indicator dot */

  .meter-indicator {
    position: absolute;
    top: -21px;
    transform: translateX(-50%);
  }

  .meter-indicator::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 5px solid var(--sl-color-gray-3);
    animation: ripple 2s infinite;
    z-index: 0;
  }

  .meter-fill {
    position: relative;
    width: 12px;
    height: 20px;
    background: white;
    border-radius: 15px;
    border: 2px solid var(--sl-color-gray-4);
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.35);
    z-index: 1;
  }

  @keyframes ripple {
    from {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.8;
    }
    to {
      transform: translate(-50%, -50%) scale(3);
      opacity: 0;
    }
  }

  /* text */

  .stat-card h3 {
    margin-bottom: 0.6rem;
  }

  .status {
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }

  .message {
    font-size: 0.9rem;
    margin-top: 5px;
    color: var(--sl-color-text-secondary);
    text-align: justify;
  }

  /* updated */

  .updated {
    display: inline-block;
    margin-top: 6px;
    font-size: 0.8rem;
    color: var(--sl-color-text-secondary);
    border: 1px solid var(--sl-color-gray-5);
    padding: 3px 5px;
    border-radius: 6px;
    width: fit-content;
    background-color: var(--sl-color-black);
  }

  /* news section */

  .src-title {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .news-src {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .src-pill {
    display: flex;
    text-decoration: none;
    color: var(--sl-color-text);
    font-size: 0.75rem;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.5rem;
    border-radius: 15px;
    border: 1px solid var(--sl-color-gray-5);
    transition: all 0.2s ease-in-out;
  }
  .src-pill:hover {
    border: 1px solid var(--sl-color-accent);
    background-color: var(--sl-color-black);
  }

  .src-pill .pill-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    object-fit: cover;
  }

  /* stat card */

  .stat {
    text-align: center;
    justify-content: center;
  }

  .big-stat {
    font-size: 2.6rem;
    font-weight: 700;
    margin: 0.5rem 0;
  }

  /* status colors */

  .big-stat.stable {
    color: #16a34a;
  }

  .big-stat.caution {
    color: #ffe169;
    -webkit-text-stroke: 1px #000000bf;
  }

  .big-stat.warning {
    color: #cf7917;
  }

  .big-stat.disrupted {
    color: #d92d20;
  }

  .stat-text {
    font-size: 0.9rem;
    color: var(--sl-color-text-secondary);
    text-align: justify;
  }
</style>
