---
interface Props {
  icon: string;
  title: string;
  emergency?: boolean;
  spanFull?: boolean;
}

const { icon, title, emergency = false, spanFull = false } = Astro.props;
---

<details
  class:list={["tk-accordion", { "tk-emergency": emergency }]}
  data-id={title.toLowerCase().replace(/\s+/g, "-")}
  open={spanFull ? "true" : undefined}
>
  <summary class="tk-title">
    <span class="title-inner"><span class="t-icon">{icon}</span> {title}</span>
  </summary>
  <div class="tk-card">
    <slot />
  </div>
</details>

<style is:global>
  .tk-card {
    border-radius: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .span-full {
    grid-column: 1 / -1;
  }
</style>
